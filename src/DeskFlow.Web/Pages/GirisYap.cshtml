
@page
@model DeskFlow.Web.Pages.GirisYapModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-4">
        <h1 class="h3 mb-4 text-center">Giriş Yap</h1>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">E-posta</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Sifre" class="form-label">Şifre</label>
                <input asp-for="Input.Sifre" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Sifre" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.BeniHatirla" class="form-check-input" />
                <label asp-for="Input.BeniHatirla" class="form-check-label">Beni hatırla</label>
            </div>

            <button type="submit" class="btn btn-dark df-btn w-100">Giriş Yap</button>

            <p class="mt-3 text-center">
                Hesabın yok mu? <a asp-page="/KayitOl">Kayıt ol</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
