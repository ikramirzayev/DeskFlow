@page
@model DeskFlow.Web.Pages.CheckInModel
@{
    ViewData["Title"] = "Check-in";
}

<h1 class="h3 mb-3">Check-in</h1>
<p class="text-muted">Masanın üzerindeki QR kodun altında yazan kodu girin (örneğin <code>DF-S1-M03</code>).</p>

@if (Model.Sonuc is not null)
{
    <div class="alert @(Model.Sonuc.Basarili ? "alert-success" : "alert-danger")" role="alert">
        @Model.Mesaj
    </div>
}

<form method="post" class="row g-2" style="max-width: 480px;">
    <div class="col">
        <input asp-for="Kod" class="form-control" placeholder="Masa kodu" autocomplete="off" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-dark df-btn">Check-in yap</button>
    </div>
</form>