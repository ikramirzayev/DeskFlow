@page
@model DeskFlow.Web.Pages.Admin.Masalar.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1 class="h3 mb-3">Masa Düzenle</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Masa.Id" />
            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Masa.MasaNo" class="control-label">Masa No</label>
                <input asp-for="Masa.MasaNo" class="form-control" aria-required="true"/>
                <span asp-validation-for="Masa.MasaNo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Masa.SalonId" class="control-label">Salon</label>
                <select asp-for="Masa.SalonId" class="form-control" asp-items="ViewBag.SalonId"></select>                
                <span asp-validation-for="Masa.SalonId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Masa.X" class="control-label">Harita X Konumu</label>
                <input asp-for="Masa.X" class="form-control" />
                <span asp-validation-for="Masa.X" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Masa.Y" class="control-label">Harita Y Konumu</label>
                <input asp-for="Masa.Y" class="form-control" />
                <span asp-validation-for="Masa.Y" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Masa.PrizliMi" class="control-label">Prizli</label>
                <input asp-for="Masa.PrizliMi" class="form-check-input" />
                <span asp-validation-for="Masa.PrizliMi" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Masa.SessizBolgeMi" class="control-label">Sessiz Bölge</label>
                <input asp-for="Masa.SessizBolgeMi" class="form-check-input" />
                <span asp-validation-for="Masa.SessizBolgeMi" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Masa.QrKod" class="control-label">QR Kod (Boş bırakılırsa otomatik üretilir.)</label>
                <input asp-for="Masa.QrKod" class="form-control" data-val="false"/>
                <span asp-validation-for="Masa.QrKod" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Masa.AktifMi" class="control-label">Aktif</label>
                <input asp-for="Masa.AktifMi" class="form-check-input" />
                <span asp-validation-for="Masa.AktifMi" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <input type="submit" value="Kaydet" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Listeye Dön</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
