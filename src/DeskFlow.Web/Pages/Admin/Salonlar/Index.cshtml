@page
@model DeskFlow.Web.Pages.Admin.Salonlar.IndexModel
@{
    ViewData["Title"] = "Salon Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Salon Yönetimi</h1>
    <a asp-page="Create" class="btn btn-primary">Yeni Salon Ekle</a>
</div>

@if (Model.Salonlar.Count == 0)
{
    <div class="alert alert-info">Henüz salon eklenmemiş.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Kat</th>
                    <th>Kapasite</th>
                    <th>Masa Sayısı</th>
                    <th>Açılış – Kapanış</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Salonlar)
                {
                    <tr>
                        <td>@s.Ad</td>
                        <td>@s.Kat</td>
                        <td>@s.Kapasite</td>
                        <td>@s.MasaSayisi</td>
                        <td>@s.AcilisSaati.ToString("HH:mm") – @s.KapanisSaati.ToString("HH:mm")</td>
                        <td>
                            @if (s.AktifMi)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <a asp-page="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
