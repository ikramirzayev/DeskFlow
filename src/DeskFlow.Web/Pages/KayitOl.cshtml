
@page
@model DeskFlow.Web.Pages.KayitOlModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-4">
        <h1 class="h3 mb-4 text-center">Kayıt Ol</h1>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Ad" class="form-label">Ad</label>
                <input asp-for="Input.Ad" class="form-control" />
                <span asp-validation-for="Input.Ad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Soyad" class="form-label">Soyad</label>
                <input asp-for="Input.Soyad" class="form-control" />
                <span asp-validation-for="Input.Soyad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.OgrenciNo" class="form-label">Öğrenci Numarası</label>
                <input asp-for="Input.OgrenciNo" class="form-control" />
                <span asp-validation-for="Input.OgrenciNo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">E-posta</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Sifre" class="form-label">Şifre</label>
                <input asp-for="Input.Sifre" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Sifre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.SifreTekrar" class="form-label">Şifre (Tekrar)</label>
                <input asp-for="Input.SifreTekrar" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.SifreTekrar" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-dark df-btn w-100">Kayıt Ol</button>

            <p class="mt-3 text-center">
                Zaten hesabın var mı? <a asp-page="/GirisYap">Giriş yap</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
